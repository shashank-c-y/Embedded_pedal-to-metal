# Build output (regenerated by `make`, don't track binaries)
Debug/
Release/
*.elf
*.bin
*.hex
*.map
*.list
*.o
*.d
*.su

# CubeIDE / Eclipse workspace metadata (machine-specific, not shareable)
.metadata/
.settings/
*.launch

# Keep these — they ARE meant to be tracked:
# .cproject, .project, .mxproject  -> CubeIDE project definition
# *.ioc                             -> CubeMX pin/clock config (the actual source of truth)
# Core/, Drivers/                   -> generated + your source code
# makefile, objects.mk, sources.mk  -> build recipe
# wokwi.toml, diagram.json          -> simulation config
# .vscode/launch.json               -> debug config (if not machine-specific)

# OS junk
.DS_Store
Thumbs.db

# VSCode local settings (keep launch.json, ignore personal workspace state)
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
